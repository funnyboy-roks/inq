%YAML 1.2
---
# See http://www.sublimetext.com/docs/syntax.html
file_extensions:
  - inq
scope: source.inq
contexts:
  main:
    # Strings begin and end with quotes, and use backslashes as an escape
    # character
    - match: '"'
      scope: punctuation.definition.string.begin.inq
      push: double_quoted_string

    # Comments begin with a '//' and finish at the end of the line
    - match: '//'
      scope: punctuation.definition.comment.inq
      push: line_comment

    - match: '#\['
      scope: punctuation.definition.annotation.inq
      push: attribute

    - match: '\b(let|if|then|else|route|before|request|after|response)\b'
      scope: keyword.control.inq

    # Numbers
    - match: '\b(-)?[0-9.]+\b'
      scope: constant.numeric.inq
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.inq
    - match: '\bnull\b'
      scope: constant.language.null.inq

  double_quoted_string:
    - meta_scope: string.quoted.double.inq
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.inq
      push:
        - clear_scopes: 1
        - include: main
        - match: '\}'
          scope: punctuation.section.interpolation.end.inq
          pop: true
    - match: '\\.'
      scope: constant.character.escape.inq
    - match: '"'
      scope: punctuation.definition.string.end.inq
      pop: true

  line_comment:
    - meta_scope: comment.line.inq
    - match: $
      pop: true

  attribute:
    - meta_scope: string.quoted.double.inq
    - match: '\]'
      scope: punctuation.definition.annotation.inq
      pop: true
