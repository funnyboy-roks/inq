let port = 3000;
let host = env("HOST") || "example.com";
let BASE_URL = "https://$host${ if port == 443 then "" else ":$port" }";

#[persist]
let cookie = "";

route notifications(user_id = "") => GET "/notifications${params({ user_id })}";

route notifications/new(level, message, source) => POST "/notifications"
    before {
        request.body = json({
            level,
            message,
            source,
            title: "hello world",
        });
        request.headers["content-type"] = "application/json";
    }
    after {
        cookie = response.headers["cookie"];
    }


