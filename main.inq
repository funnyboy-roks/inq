let port = 3000;
let BASE_URL = "http://localhost:$port";

#[persist]
let cookie = "";
#[persist]
let user = "john";
#[persist]
let password = read_text_file("./password");

route login() => POST "/login"
    before {
        request.body = json({
            username: user,
            password: password,
        })
    }
    after {
        let cookie_header = response.headers["set-cookie"].parse_cookie();
        cookie = expires(cookie_header.value, cookie_header.expires_at);
    }

route file => POST "/echo"
    before {
        request.body = read_text_file("./password")
    }

route raw => POST "/echo"
    before {
        body = Bytes.from_hex("dGhocyBpcyBzb21lIGJpbmFyeSBkYXRhLCBub3QgbmVjZXNzYXJpbHkgdmFsaWQgdXRm")
    }

route status(code = 401) => GET "/status/${code}";
route status2(code = 401) => GET "https://httpbin.org/status/${code}";
route json => POST "/json"
    before {
        request.body = json({
            first_name: "John",
            last_name: "Smith",
            is_alive: true,
            age: 27,
            address: {
                street_address: "21 2nd Street",
                city: "New York",
                state: "NY",
                postal_code: "10021-3100"
            },
            phone_numbers: [
                { type: "home", number: "212 555-1234" },
                { type: "office", number: "646 555-4567" },
            ],
            children: ["Catherine", "Thomas", "Trevor"],
            spouse: null,
            empty_obj: {},
            empty_arr: []
        })
    }
